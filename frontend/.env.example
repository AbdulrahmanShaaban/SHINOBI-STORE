# Frontend environment (copy to .env.local)

# Backend API base URL — server components fetch product data from here.
API_URL=http://localhost:5000

# Browser-facing API base (cart availability revalidation). Must be reachable
# by visitors; the backend CORS allowlist must include this storefront origin.
NEXT_PUBLIC_API_URL=http://localhost:5000

# Public site URL used for SEO metadata / JSON-LD offer links.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

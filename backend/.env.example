# Server
PORT=5000
NODE_ENV=development

# Database (matches docker-compose.dev.yml)
DATABASE_URL=postgresql://shinobi:shinobi_dev_password@localhost:5432/shinobi_store?schema=public

# Redis (matches docker-compose.dev.yml)
REDIS_URL=redis://localhost:6379

# CORS
CORS_ORIGIN=http://localhost:3000

# Media storage (§Phase 8) — when ALL three are set, uploads go to Cloudinary;
# otherwise the local mock adapter is used (placeholder URLs, no external I/O).
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

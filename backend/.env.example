# Server
PORT=5000
NODE_ENV=development

# Database (matches docker-compose.dev.yml)
DATABASE_URL=postgresql://shinobi:shinobi_dev_password@localhost:5432/shinobi_store?schema=public

# Redis (matches docker-compose.dev.yml)
REDIS_URL=redis://localhost:6379

# CORS
CORS_ORIGIN=http://localhost:3000

# Payments (Stripe). Leave STRIPE_SECRET_KEY EMPTY to run the dev mock provider
# (orders reserve + auto-confirm without touching Stripe). Setting a secret key
# switches every payment to real Stripe automatically at boot.
#   STRIPE_SECRET_KEY:     sk_test_… / sk_live_… from dashboard → Developers → API keys.
#                          Production REQUIRES the real (live) key — env.validation.ts
#                          enforces this outside development.
#   STRIPE_WEBHOOK_SECRET: whsec_… from dashboard → Developers → Webhooks (point the
#                          endpoint at POST {API_URL}/api/v1/orders/webhooks/stripe,
#                          event types: payment_intent.succeeded, payment_intent.payment_failed).
#                          Without it, webhook signatures cannot be verified and no
#                          Stripe event will ever confirm an order.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Media storage (§Phase 8) — when ALL three are set, uploads go to Cloudinary;
# otherwise the local mock adapter is used (placeholder URLs, no external I/O).
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
